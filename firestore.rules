rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isLeader() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'leader';
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isPastorEmail() {
      return isSignedIn() && request.auth.token.email == 'pastor@tcfcva.com';
    }

    function isPrayerMinistryEmail() {
      return isSignedIn() && request.auth.token.email == 'prayerministry@tcfcva.com';
    }

    // Users can read/write their own document; leaders can read all
    // Leaders can also update only the role field on any user document
    match /users/{uid} {
      allow read: if isOwner(uid) || isLeader();
      allow write: if isOwner(uid);
      allow update: if isLeader() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']);
    }

    // Events: anyone can read, only leaders (incl. ministry leaders) can write
    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if isLeader();
    }

    // Prayer requests:
    // - Pastor requests: only the author and pastor@tcfcva.com can read
    // - Prayer Ministry requests: only the author and prayerministry@tcfcva.com can read
    // - Only author can delete their own request
    // - Only recipient leader can update prayingCount/prayingUids
    match /prayerRequests/{requestId} {
      allow read: if isOwner(resource.data.authorUid)
                  || (resource.data.recipient == 'pastor' && isPastorEmail())
                  || (resource.data.recipient == 'prayer_ministry' && isPrayerMinistryEmail());
      allow create: if isSignedIn();
      allow delete: if isOwner(resource.data.authorUid)
                    || (resource.data.recipient == 'pastor' && isPastorEmail())
                    || (resource.data.recipient == 'prayer_ministry' && isPrayerMinistryEmail());
      allow update: if (isPastorEmail() || isPrayerMinistryEmail()) &&
                      request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['prayingCount', 'prayingUids']);
    }
  }
}
